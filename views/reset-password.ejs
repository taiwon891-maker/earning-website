<!DOCTYPE html>
<html>
<head><title>Reset Password</title></head>
<body style="font-family: Arial; padding: 20px;">
  <h2>Reset Password</h2>
  <form action="/reset-password" method="POST">
    <input type="email" name="username" placeholder="Registered Email" required><br><br>
    <input type="text" name="otp" placeholder="6-Digit OTP Code" required><br><br>
    <input type="password" name="newPassword" placeholder="New Password" required><br><br>
    <button type="submit">Set New Password</button>
  </form>
</body>
</html>
